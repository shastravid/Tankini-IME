store(&VERSION) '10.0'
store(&NAME) 'Tankini Sanskrit'
store(&TARGETS) 'any'
store(&COPYRIGHT) '© 2026'
store(&KEYBOARDVERSION) '1.0'
c store(&VISUALKEYBOARD) 'tankini_sanskrit.kvks'
c store(&LAYOUTFILE) 'tankini_sanskrit.keyman-touch-layout'

begin Unicode > use(main)

c ----------------------------------------------------------------------------
c Stores
c ----------------------------------------------------------------------------

store(VowelKeys)    'a'    'i'    'u'    'R'    'e'    'o'    'A'    'I'    'U'    'E'    'O'
store(Vowels)       'अ'    'इ'    'उ'    'ऋ'    'ए'    'ओ'    'आ'    'ई'    'ऊ'    'ए'    'ओ'

store(MatraKeys)    'A'    'i'    'I'    'u'    'U'    'R'    'e'    'E'    'o'    'O'
store(Matras)       'ा'    'ि'    'ी'    'ु'    'ू'    'ृ'    'े'    'े'    'ो'    'ो'

c Consonant Keys (Standard)
c Removed 'X' as it is Svarita, not a consonant base for virama logic.
store(ConsonantKeys) 'k' 'g' 'c' 'j' 'T' 'D' 'N' 't' 'd' 'n' 'p' 'b' 'm' 'y' 'r' 'l' 'v' 'w' 's' 'h' 'L' 'K' 'G' 'C' 'J' 'S' 'P' 'B' 'x'
store(Consonants)    'क' 'ग' 'च' 'ज' 'ट' 'ड' 'ण' 'त' 'द' 'न' 'प' 'ब' 'म' 'य' 'र' 'ल' 'व' 'व' 'स' 'ह' 'ळ' 'ख' 'घ' 'छ' 'झ' 'श' 'फ' 'भ' 'क्ष' 'ठ' 'ढ' 'थ' 'ध' 'ङ' 'ञ' 'ज्ञ' 'ष'

store(NumberKeys) '0'..'9'
store(Numbers)    '०'..'९'

group(main) using keys

c ----------------------------------------------------------------------------
c Vowels (Independent)
c ----------------------------------------------------------------------------
+ 'a' > 'अ'
'अ' + 'a' > 'आ'
+ 'A' > 'आ'
+ 'i' > 'इ'
'इ' + 'i' > 'ई'
+ 'I' > 'ई'
'e' + 'e' > 'ई'
+ 'u' > 'उ'
'उ' + 'u' > 'ऊ'
+ 'U' > 'ऊ'
'o' + 'o' > 'ऊ'
+ 'R' > 'ऋ'
'ऋ' + 'R' > 'ॠ'
+ 'e' > 'ए'
+ 'E' > 'ए'

+ 'o' > 'ओ'
+ 'O' > 'ओ'

'अ' + 'i' > 'ऐ'
'अ' + 'u' > 'औ'

c 'l' + 'R' > 'ऌ' c Handled below

c ----------------------------------------------------------------------------
c Modifiers
c ----------------------------------------------------------------------------
+ 'M' > 'ं'
+ 'H' > 'ः'
+ '\' > '्'
'ं' + '.' > 'ँ'

c ----------------------------------------------------------------------------
c Special & Vedic
c ----------------------------------------------------------------------------
+ 'q' > '॰'
+ 'z' > '॰'
+ '.' > '।'
'।' + '.' > '॥'
'।' + 'a' > 'ऽ'
'.' + 'a' > 'ऽ'
'ओ' + 'M' > 'ॐ'
'औ' + 'm' > 'ॐ'
'आ' 'ऊ' + 'M' > 'ॐ'

+ '_' > '॒'
+ 'X' > '॑'
'॑' + 'X' > '᳚'

c ----------------------------------------------------------------------------
c Latin-Buffer Logic (Solves Mac Backspace Bug)
c ----------------------------------------------------------------------------

c 1. Latin Output for Consonants (Initial State)
+ any(ConsonantKeys) > index(ConsonantKeys, 1)

c 2. Latin + 'a' -> Devanagari (Explicit A)
any(ConsonantKeys) + 'a' > index(Consonants, 1)

c 3. Latin + Matra -> Deva + Matra
any(ConsonantKeys) + any(MatraKeys) > index(Consonants, 1) index(Matras, 2)

c 4. Latin + Latin -> Deva + Virama + Latin (Conjunct Formation)
any(ConsonantKeys) + any(ConsonantKeys) > index(Consonants, 1) '्' index(ConsonantKeys, 2)

c 5. Latin + Space/Punctuation -> Deva + Virama + Space (Word Ending)
c We need specific rules for space and common punctuation to "commit" the halant.
any(ConsonantKeys) + ' ' > index(Consonants, 1) '्' ' '
any(ConsonantKeys) + '.' > index(Consonants, 1) '्' '।'
any(ConsonantKeys) + ',' > index(Consonants, 1) '्' ','
any(ConsonantKeys) + U+000D > index(Consonants, 1) '्' U+000D

c 6. Double Vowels (aa/ii/uu)
c Handle 'aa' specifically after Latin Consonant?
c 'k' + 'a' -> 'क'. 'क' + 'a' > 'का'.
'अ' + 'a' > 'आ'
any(Consonants) + 'a' > context 'ा'
any(Consonants) + 'i' > context 'ै'
any(Consonants) + 'u' > context 'ौ'

c 7. Explicit Virama (Commit)
any(ConsonantKeys) + '\' > index(Consonants, 1) '्'

c 8. Aspirates (Handling 'h' if 'h' is in ConsonantKeys)
c Use standard logic since 'h' is a key. 'k'+'h' -> 'k'+'h' -> 'क्'+'h' -> Special Aspirate Rule?
c Re-implement Aspirates matching DEVANAGARI context (since 'k'+'h' becomes 'क्'+'h')
'क' '्' + 'h' > 'ख' '्' 
'ग' '्' + 'h' > 'घ' '्'
'च' '्' + 'h' > 'छ' '्'
'ज' '्' + 'h' > 'झ' '्'
'ट' '्' + 'h' > 'ठ' '्'
'ड' '्' + 'h' > 'ढ' '्'
'त' '्' + 'h' > 'थ' '्'
'द' '्' + 'h' > 'ध' '्'
'प' '्' + 'h' > 'फ' '्'
'ब' '्' + 'h' > 'भ' '्'
'स' '्' + 'h' > 'श' '्'
'श' '्' + 'h' > 'ष' '्'

c Special Special
'न' '्' + 'g' > 'ङ' '्'
'न' '्' + 'j' > 'ञ' '्'
'ग' '्' + 'Y' > 'ज्ञ' '्'
'ल' '्' + 'R' > 'ऌ' 

c Numbers
+ any(NumberKeys) > index(Numbers, 1)

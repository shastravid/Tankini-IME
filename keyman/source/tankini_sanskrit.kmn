store(&VERSION) '10.0'
store(&NAME) 'Tankini Sanskrit'
store(&TARGETS) 'any'
store(&COPYRIGHT) '© 2026'
store(&KEYBOARDVERSION) '1.0'
store(&VISUALKEYBOARD) 'tankini_sanskrit.kvks'
store(&LAYOUTFILE) 'tankini_sanskrit.keyman-touch-layout'

begin Unicode > use(main)

c ============================================================================
c STORES
c ============================================================================

c Consonant Latin Keys (Buffer Logic)
store(ConsonantKeys) 'k' 'g' 'c' 'j' 'T' 'D' 'N' 't' 'd' 'n' 'p' 'b' 'm' 'y' 'r' 'l' 'v' 'w' 's' 'h' 'L' 'K' 'G' 'C' 'J' 'S' 'P' 'B'
store(Consonants)    'क' 'ग' 'च' 'ज' 'ट' 'ड' 'ण' 'त' 'द' 'न' 'प' 'ब' 'म' 'य' 'र' 'ल' 'व' 'व' 'स' 'ह' 'ळ' 'ख' 'घ' 'छ' 'झ' 'श' 'फ' 'भ'

c Matra Keys and Matras (applied after consonants)
store(MatraKeys)    'A'    'i'    'I'    'u'    'U'    'R'    'e'    'E'    'o'    'O'
store(Matras)       'ा'    'ि'    'ी'    'ु'    'ू'    'ृ'    'े'    'े'    'ो'    'ो'

c All Devanagari Consonants (for context matching after Deva output)
store(AllDevaConsonants) 'क' 'ख' 'ग' 'घ' 'ङ' 'च' 'छ' 'ज' 'झ' 'ञ' 'ट' 'ठ' 'ड' 'ढ' 'ण' 'त' 'थ' 'द' 'ध' 'न' 'प' 'फ' 'ब' 'भ' 'म' 'य' 'र' 'ल' 'व' 'श' 'ष' 'स' 'ह' 'क्ष' 'ज्ञ' 'ळ'

c Numbers
store(NumberKeys) '0'..'9'
store(Numbers)    '०'..'९'

group(main) using keys

c ============================================================================
c SECTION 1: PUNCTUATION COMMIT RULES
c (When consonant is in buffer and punctuation/space typed, commit it first)
c ============================================================================

c Space commits consonant with halant
any(ConsonantKeys) + [K_SPACE] > index(Consonants, 1) '्' ' '

c Comma commits consonant with halant
any(ConsonantKeys) + [K_COMMA] > index(Consonants, 1) '्' ','

c Period commits consonant with halant + danda
any(ConsonantKeys) + [K_PERIOD] > index(Consonants, 1) '्' '।'

c Enter commits consonant with halant
any(ConsonantKeys) + [K_ENTER] > index(Consonants, 1) '्' U+000D

c Hyphen commits consonant with halant (for compound words)
any(ConsonantKeys) + [K_HYPHEN] > index(Consonants, 1) '्' '-'

c Parentheses commit consonant with halant
any(ConsonantKeys) + '(' > index(Consonants, 1) '्' '('
any(ConsonantKeys) + ')' > index(Consonants, 1) '्' ')'

c Default punctuation (no consonant context)
+ [K_COMMA] > ','
+ [K_PERIOD] > '।'
+ [K_HYPHEN] > '-'
+ '(' > '('
+ ')' > ')'

c ============================================================================
c SECTION 2: NUMBERS
c ============================================================================

+ any(NumberKeys) > index(Numbers, 1)

c ============================================================================
c SECTION 3: INDEPENDENT VOWELS
c ============================================================================

+ 'a' > 'अ'
'अ' + 'a' > 'आ'
+ 'A' > 'आ'

+ 'i' > 'इ'
'इ' + 'i' > 'ई'
+ 'I' > 'ई'

+ 'u' > 'उ'
'उ' + 'u' > 'ऊ'
+ 'U' > 'ऊ'

+ 'R' > 'ऋ'
'ऋ' + 'R' > 'ॠ'

+ 'e' > 'ए'
+ 'E' > 'ए'
'ए' + 'e' > 'ई'

+ 'o' > 'ओ'
+ 'O' > 'ओ'
'ओ' + 'o' > 'ऊ'

c Diphthongs from 'अ'
'अ' + 'i' > 'ऐ'
'अ' + 'u' > 'औ'

c ============================================================================
c SECTION 4: VOCALIC L (lR/lRR)
c Must come BEFORE generic consonant rules since 'l' is a ConsonantKey
c ============================================================================

'l' + 'R' > 'ऌ'
'ऌ' + 'R' > 'ॡ'

c ============================================================================
c SECTION 5: MODIFIERS & SPECIAL SYMBOLS
c ============================================================================

+ 'M' > 'ं'
+ 'H' > 'ः'
+ [K_BKSLASH] > '्'
'ं' + [K_PERIOD] > 'ँ'

c Danda / Double Danda / Avagraha
'।' + [K_PERIOD] > '॥'
'।' + 'a' > 'ऽ'

c Abbreviation
+ 'q' > '॰'

c OM (Pranava)
'ओ' + 'M' > 'ॐ'
'औ' + 'm' > 'ॐ'

c Vedic Accents
+ 'Z' > '॒'
+ 'X' > '॑'
'॑' + 'X' > '᳚'

c ============================================================================
c SECTION 6: LATIN-BUFFER CONSONANT LOGIC
c (Core of Tankini: consonant keys output Latin first, then resolve)
c ============================================================================

c 6.1 Initial Latin output for any consonant key
+ any(ConsonantKeys) > index(ConsonantKeys, 1)

c 6.2 Latin + 'a' -> Devanagari (implicit 'a' vowel)
any(ConsonantKeys) + 'a' > index(Consonants, 1)

c 6.3 Latin + Matra -> Devanagari + Matra
any(ConsonantKeys) + any(MatraKeys) > index(Consonants, 1) index(Matras, 2)

c ============================================================================
c SECTION 7: ASPIRATES (Latin + h -> Aspirated Consonant + Deadkey)
c ============================================================================

'k' + 'h' > 'ख' deadkey(asp)
'g' + 'h' > 'घ' deadkey(asp)
'c' + 'h' > 'छ' deadkey(asp)
'j' + 'h' > 'झ' deadkey(asp)
'T' + 'h' > 'ठ' deadkey(asp)
'D' + 'h' > 'ढ' deadkey(asp)
't' + 'h' > 'थ' deadkey(asp)
'd' + 'h' > 'ध' deadkey(asp)
'p' + 'h' > 'फ' deadkey(asp)
'b' + 'h' > 'भ' deadkey(asp)
's' + 'h' > 'श' deadkey(asp)
'S' + 'h' > 'ष' deadkey(asp)

c shh -> ष (alternate: sh then h re-triggers to give ष)
c shh -> ष handled by: after sh produces श+deadkey(asp), typing 'h' again
c Since 'h' is in ConsonantKeys, the generic rule deadkey(asp)+ConsonantKeys fires,
c outputting '्' + 'h'. The 'h' buffer then stays for next input.
c For explicit Sh support, 'S'+'h' -> ष+deadkey is already present above.

c Deadkey(asp) follow-up rules
deadkey(asp) + 'a' > nul
deadkey(asp) + any(MatraKeys) > index(Matras, 2)
deadkey(asp) + any(ConsonantKeys) > '्' index(ConsonantKeys, 2)
deadkey(asp) + 'M' > 'ं'
deadkey(asp) + 'H' > 'ः'
deadkey(asp) + [K_BKSLASH] > '्'
deadkey(asp) + [K_SPACE] > '्' ' '
deadkey(asp) + [K_COMMA] > '्' ','
deadkey(asp) + [K_PERIOD] > '्' '।'
deadkey(asp) + [K_HYPHEN] > '्' '-'
deadkey(asp) + '(' > '्' '('
deadkey(asp) + ')' > '्' ')'



c ============================================================================
c SECTION 8: CONJUNCTS (jY/gY -> ज्ञ, x -> क्ष)
c ============================================================================

c Jnya Formation (j/g + Y)
'j' + 'Y' > 'ज्ञ' '्'
'g' + 'Y' > 'ज्ञ' '्'
'ज्ञ' '्' + 'a' > 'ज्ञ'

c Explicit Nya (Y alone)
'n' + 'Y' > 'ञ' '्'
+ 'Y' > 'ञ' '्'
'ञ' '्' + 'a' > 'ञ'
any(ConsonantKeys) + 'Y' > index(Consonants, 1) '्' 'ञ' '्'
deadkey(asp) + 'Y' > '्' 'ञ' '्'

c Ksha Formation (x)
+ 'x' > 'क्ष' '्'
'क्ष' '्' + 'a' > 'क्ष'
any(ConsonantKeys) + 'x' > index(Consonants, 1) '्' 'क्ष' '्'
deadkey(asp) + 'x' > '्' 'क्ष' '्'

c Matra rules for ञ (Explicit, avoids KM02032)
'ञ' '्' + 'A' > 'ञ' 'ा'
'ञ' '्' + 'i' > 'ञ' 'ि'
'ञ' '्' + 'I' > 'ञ' 'ी'
'ञ' '्' + 'u' > 'ञ' 'ु'
'ञ' '्' + 'U' > 'ञ' 'ू'
'ञ' '्' + 'R' > 'ञ' 'ृ'
'ञ' '्' + 'e' > 'ञ' 'े'
'ञ' '्' + 'E' > 'ञ' 'े'
'ञ' '्' + 'o' > 'ञ' 'ो'
'ञ' '्' + 'O' > 'ञ' 'ो'

c Matra rules for ज्ञ
'ज्ञ' '्' + 'A' > 'ज्ञ' 'ा'
'ज्ञ' '्' + 'i' > 'ज्ञ' 'ि'
'ज्ञ' '्' + 'I' > 'ज्ञ' 'ी'
'ज्ञ' '्' + 'u' > 'ज्ञ' 'ु'
'ज्ञ' '्' + 'U' > 'ज्ञ' 'ू'
'ज्ञ' '्' + 'R' > 'ज्ञ' 'ृ'
'ज्ञ' '्' + 'e' > 'ज्ञ' 'े'
'ज्ञ' '्' + 'E' > 'ज्ञ' 'े'
'ज्ञ' '्' + 'o' > 'ज्ञ' 'ो'
'ज्ञ' '्' + 'O' > 'ज्ञ' 'ो'

c Matra rules for क्ष
'क्ष' '्' + 'A' > 'क्ष' 'ा'
'क्ष' '्' + 'i' > 'क्ष' 'ि'
'क्ष' '्' + 'I' > 'क्ष' 'ी'
'क्ष' '्' + 'u' > 'क्ष' 'ु'
'क्ष' '्' + 'U' > 'क्ष' 'ू'
'क्ष' '्' + 'R' > 'क्ष' 'ृ'
'क्ष' '्' + 'e' > 'क्ष' 'े'
'क्ष' '्' + 'E' > 'क्ष' 'े'
'क्ष' '्' + 'o' > 'क्ष' 'ो'
'क्ष' '्' + 'O' > 'क्ष' 'ो'

c ============================================================================
c SECTION 9: HOMORGANIC NASALS
c (n + guttural/palatal -> appropriate nasal)
c ============================================================================

c n + velar -> ङ (but NOT n+k, to allow dental n+k as in varNAnkramAn)
'n' + 'g' > 'ङ' '्' 'g'
'n' + 'G' > 'ङ' '्' 'G'
'n' + 'K' > 'ङ' '्' 'K'

c n + palatal -> ञ
'n' + 'c' > 'ञ' '्' 'c'
'n' + 'j' > 'ञ' '्' 'j'
'n' + 'C' > 'ञ' '्' 'C'
'n' + 'J' > 'ञ' '्' 'J'

c Dedup logic (ngg -> ङ्g, ngkg -> ङ्k+g, etc.)
'ङ' '्' 'k' + 'k' > 'ङ' '्' 'k'
'ङ' '्' 'g' + 'g' > 'ङ' '्' 'g'
'ञ' '्' 'c' + 'c' > 'ञ' '्' 'c'
'ञ' '्' 'j' + 'j' > 'ञ' '्' 'j'
'ङ' '्' 'k' + 'K' > 'ङ' '्' 'K'
'ङ' '्' 'g' + 'G' > 'ङ' '्' 'G'
'ङ' '्' 'g' + 'k' > 'ङ' '्' 'k'
'ङ' '्' 'g' + 'K' > 'ङ' '्' 'K'
'ङ' '्' 'g' + 'x' > 'ङ' '्' 'क्ष' '्'
'ङ' '्' 'g' + [K_HYPHEN] > 'ङ' '्' '-'
'ञ' '्' 'c' + 'C' > 'ञ' '्' 'C'
'ञ' '्' 'j' + 'J' > 'ञ' '्' 'J'

c ============================================================================
c SECTION 10: CONSONANT CLUSTER (Latin + Latin -> Deva + Virama + Latin)
c ============================================================================

any(ConsonantKeys) + any(ConsonantKeys) > index(Consonants, 1) '्' index(ConsonantKeys, 2)

c ============================================================================
c SECTION 11: MODIFIER AFTER CONSONANT BUFFER
c (kM -> कं, kH -> कः — implicit 'a' before modifier)
c ============================================================================

any(ConsonantKeys) + 'M' > index(Consonants, 1) 'ं'
any(ConsonantKeys) + 'H' > index(Consonants, 1) 'ः'

c ============================================================================
c SECTION 12: DOUBLE VOWELS AFTER DEVANAGARI CONSONANT
c (consonant already resolved to Devanagari, now handle aa/ii/uu/ee/oo/ai/au)
c ============================================================================

c aa -> A (long vowel matra after consonant)
any(AllDevaConsonants) + 'a' > context 'ा'

c ai -> diphthong matra
any(AllDevaConsonants) + 'i' > context 'ै'

c au -> diphthong matra
any(AllDevaConsonants) + 'u' > context 'ौ'

c ii -> I (short matra -> long matra)
any(AllDevaConsonants) 'ि' + 'i' > index(AllDevaConsonants, 1) 'ी'

c uu -> U (short matra -> long matra)
any(AllDevaConsonants) 'ु' + 'u' > index(AllDevaConsonants, 1) 'ू'
'ू' + 'u' > context

c ee -> I (alternate for ii)
any(AllDevaConsonants) 'े' + 'e' > index(AllDevaConsonants, 1) 'ी'

c oo -> U (alternate for uu)
any(AllDevaConsonants) 'ो' + 'o' > index(AllDevaConsonants, 1) 'ू'

c ============================================================================
c SECTION 13: EXPLICIT VIRAMA (backslash commit)
c ============================================================================

any(ConsonantKeys) + [K_BKSLASH] > index(Consonants, 1) '्'
c Note: deadkey(asp) + [K_BKSLASH] is handled in Section 7 (aspirate deadkey rules)

store(&VERSION) '10.0'
store(&NAME) 'Tankini Sanskrit'
store(&TARGETS) 'any'
store(&COPYRIGHT) '© 2026'
store(&KEYBOARDVERSION) '1.0'
c store(&VISUALKEYBOARD) 'tankini_sanskrit.kvks'
c store(&LAYOUTFILE) 'tankini_sanskrit.keyman-touch-layout'

begin Unicode > use(main)

c ----------------------------------------------------------------------------
c Stores
c ----------------------------------------------------------------------------

store(VowelKeys)    'a'    'i'    'u'    'R'    'e'    'o'    'A'    'I'    'U'    'E'    'O'
store(Vowels)       'अ'    'इ'    'उ'    'ऋ'    'ए'    'ओ'    'आ'    'ई'    'ऊ'    'ए'    'ओ'

store(MatraKeys)    'A'    'i'    'I'    'u'    'U'    'R'    'e'    'E'    'o'    'O'
store(Matras)       'ा'    'ि'    'ी'    'ु'    'ू'    'ृ'    'े'    'े'    'ो'    'ो'

c Consonant Keys (For Buffer Logic)
store(ConsonantKeys) 'k' 'g' 'c' 'j' 'T' 'D' 'N' 't' 'd' 'n' 'p' 'b' 'm' 'y' 'r' 'l' 'v' 'w' 's' 'h' 'L' 'K' 'G' 'C' 'J' 'S' 'P' 'B'
store(Consonants)    'क' 'ग' 'च' 'ज' 'ट' 'ड' 'ण' 'त' 'द' 'न' 'प' 'ब' 'म' 'य' 'र' 'ल' 'व' 'व' 'स' 'ह' 'ळ' 'ख' 'घ' 'छ' 'झ' 'श' 'फ' 'भ'

c All Devanagari Consonants (For Matra/Vowel Context Rules)
store(AllDevaConsonants) 'क' 'ख' 'ग' 'घ' 'ङ' 'च' 'छ' 'ज' 'झ' 'ञ' 'ट' 'ठ' 'ड' 'ढ' 'ण' 'त' 'थ' 'द' 'ध' 'न' 'प' 'फ' 'ब' 'भ' 'म' 'य' 'र' 'ल' 'व' 'श' 'ष' 'स' 'ह' 'क्ष' 'ज्ञ' 'ळ'

store(NumberKeys) '0'..'9'
store(Numbers)    '०'..'९'

store(BKSP) U+0008

group(main) using keys

c ----------------------------------------------------------------------------
c Vowels (Independent)
c ----------------------------------------------------------------------------
+ 'a' > 'अ'
'अ' + 'a' > 'आ'
+ 'A' > 'आ'
+ 'i' > 'इ'
'इ' + 'i' > 'ई'
+ 'I' > 'ई'
'e' + 'e' > 'ई'
+ 'u' > 'उ'
'उ' + 'u' > 'ऊ'
+ 'U' > 'ऊ'
'o' + 'o' > 'ऊ'
+ 'R' > 'ऋ'
'ऋ' + 'R' > 'ॠ'
+ 'e' > 'ए'
+ 'E' > 'ए'

+ 'o' > 'ओ'
+ 'O' > 'ओ'

'अ' + 'i' > 'ऐ'
'अ' + 'u' > 'औ'

c 'l' + 'R' > 'ऌ' c Handled below

c ----------------------------------------------------------------------------
c Modifiers
c ----------------------------------------------------------------------------
+ 'M' > 'ं'
+ 'H' > 'ः'
+ '\' > '्'
'ं' + '.' > 'ँ'

c ----------------------------------------------------------------------------
c Special & Vedic
c ----------------------------------------------------------------------------
+ 'q' > '॰'
+ 'z' > '॰'
+ '.' > '।'
'।' + '.' > '॥'
'।' + 'a' > 'ऽ'
'.' + 'a' > 'ऽ'
'ओ' + 'M' > 'ॐ'
'औ' + 'm' > 'ॐ'
'आ' 'ऊ' + 'M' > 'ॐ'

+ '_' > '॒'
+ 'X' > '॑'
'॑' + 'X' > '᳚'

c ----------------------------------------------------------------------------
c Latin-Buffer Logic (Solves Mac Backspace Bug)
c ----------------------------------------------------------------------------

c 1. Latin Output for Consonants (Initial State)
+ any(ConsonantKeys) > index(ConsonantKeys, 1)

c 2. Latin + 'a' -> Devanagari (Explicit A)
any(ConsonantKeys) + 'a' > index(Consonants, 1)

c 3. Latin + Matra -> Deva + Matra
any(ConsonantKeys) + any(MatraKeys) > index(Consonants, 1) index(Matras, 2)

c 3.5 Aspirates (Specific Latin + h -> Deva Aspirate + Deadkey)
'k' + 'h' > 'ख' deadkey(asp)
'g' + 'h' > 'घ' deadkey(asp)
'c' + 'h' > 'छ' deadkey(asp)
'j' + 'h' > 'झ' deadkey(asp)
'T' + 'h' > 'ठ' deadkey(asp)
'D' + 'h' > 'ढ' deadkey(asp)
't' + 'h' > 'थ' deadkey(asp)
'd' + 'h' > 'ध' deadkey(asp)
'p' + 'h' > 'फ' deadkey(asp)
'b' + 'h' > 'भ' deadkey(asp)
's' + 'h' > 'श' deadkey(asp)
'S' + 'h' > 'ष' deadkey(asp)

c 3.6 Deadkey Handling
c If 'a' typed after aspirate -> Remove deadkey, Keep Aspirate (Implicit 'a').
deadkey(asp) + 'a' > nul
c If Matra -> Add Matra
deadkey(asp) + any(MatraKeys) > index(Matras, 2)
c If Consonant typed after aspirate -> Remove deadkey, Insert Virama, Add New Consonant (Latin).
deadkey(asp) + any(ConsonantKeys) > '्' index(ConsonantKeys, 2)
c If Modifier -> Add Modifier
deadkey(asp) + 'M' > 'ं'
deadkey(asp) + 'H' > 'ः'

c 3.7 Homorganic Nasals & Special Logic (Must be BEFORE generic Consumer rules)

c Explicit Y (Nya) - Halant Default / Buffer
'n' + 'Y' > 'ञ' '्'
+ 'Y' > 'ञ' '्'
'ञ' '्' + 'a' > 'ञ'
any(ConsonantKeys) + 'Y' > index(Consonants, 1) '्' 'ञ' '्'
deadkey(asp) + 'Y' > '्' 'ञ' '्'

c Explicit x (Ksha) - Halant Default / Buffer
+ 'x' > 'क्ष' '्'
'क्ष' '्' + 'a' > 'क्ष'
any(ConsonantKeys) + 'x' > index(Consonants, 1) '्' 'क्ष' '्'
deadkey(asp) + 'x' > '्' 'क्ष' '्'

c Jnya Formation (j/g + Y)
'j' + 'Y' > 'ज्ञ' '्'
'g' + 'Y' > 'ज्ञ' '्'
'ज्ञ' '्' + 'a' > 'ज्ञ'

c Homorganic Nasals (Preserve Buffer Key for Context)
'n' + 'k' > 'ङ' '्' 'k'
'n' + 'g' > 'ङ' '्' 'g'
'n' + 'c' > 'ञ' '्' 'c'
'n' + 'j' > 'ञ' '्' 'j'

c Dedup Logic (Handle double-typing e.g. ngg -> ङ्g + g -> ङ्g -> ङ्ग)
'ङ' '्' 'k' + 'k' > 'ङ' '्'
'ङ' '्' 'g' + 'g' > 'ङ' '्'
'ञ' '्' 'c' + 'c' > 'ञ' '्'
'ञ' '्' 'j' + 'j' > 'ञ' '्'

c Punctuation Commit Rules
'k' + ',' > 'क' '्' ','  c DEBUG RULE for k,
any(ConsonantKeys) + ' ' > index(Consonants, 1) '्' ' '
any(ConsonantKeys) + ',' > index(Consonants, 1) '्' ','
any(ConsonantKeys) + '.' > index(Consonants, 1) '्' '।'
any(ConsonantKeys) + U+000D > index(Consonants, 1) '्' U+000D

c Explicit Matra Rules (Expanded to avoid KM02032)
'ञ' '्' + 'A' > 'ञ' 'ा'
'ञ' '्' + 'i' > 'ञ' 'ि'
'ञ' '्' + 'I' > 'ञ' 'ी'
'ञ' '्' + 'u' > 'ञ' 'ु'
'ञ' '्' + 'U' > 'ञ' 'ू'
'ञ' '्' + 'R' > 'ञ' 'ृ'
'ञ' '्' + 'e' > 'ञ' 'े'
'ञ' '्' + 'E' > 'ञ' 'े'
'ञ' '्' + 'o' > 'ञ' 'ो'
'ञ' '्' + 'O' > 'ञ' 'ो'

'ज्ञ' '्' + 'A' > 'ज्ञ' 'ा'
'ज्ञ' '्' + 'i' > 'ज्ञ' 'ि'
'ज्ञ' '्' + 'I' > 'ज्ञ' 'ी'
'ज्ञ' '्' + 'u' > 'ज्ञ' 'ु'
'ज्ञ' '्' + 'U' > 'ज्ञ' 'ू'
'ज्ञ' '्' + 'R' > 'ज्ञ' 'ृ'
'ज्ञ' '्' + 'e' > 'ज्ञ' 'े'
'ज्ञ' '्' + 'E' > 'ज्ञ' 'े'
'ज्ञ' '्' + 'o' > 'ज्ञ' 'ो'
'ज्ञ' '्' + 'O' > 'ज्ञ' 'ो'

'क्ष' '्' + 'A' > 'क्ष' 'ा'
'क्ष' '्' + 'i' > 'क्ष' 'ि'
'क्ष' '्' + 'I' > 'क्ष' 'ी'
'क्ष' '्' + 'u' > 'क्ष' 'ु'
'क्ष' '्' + 'U' > 'क्ष' 'ू'
'क्ष' '्' + 'R' > 'क्ष' 'ृ'
'क्ष' '्' + 'e' > 'क्ष' 'े'
'क्ष' '्' + 'E' > 'क्ष' 'े'
'क्ष' '्' + 'o' > 'क्ष' 'ो'
'क्ष' '्' + 'O' > 'क्ष' 'ो'

c 4. Latin + Latin -> Deva + Virama + Latin
any(ConsonantKeys) + any(ConsonantKeys) > index(Consonants, 1) '्' index(ConsonantKeys, 2)

c 5. Latin + Space/Punctuation/Modifiers -> Deva + Virama + Char (Word Ending)
any(ConsonantKeys) + ' ' > index(Consonants, 1) '्' ' '
any(ConsonantKeys) + '.' > index(Consonants, 1) '्' '।'
any(ConsonantKeys) + ',' > index(Consonants, 1) '्' ','
any(ConsonantKeys) + U+000D > index(Consonants, 1) '्' U+000D
c Modifiers commit the previous consonant (with implicit a? No, Consonant buffer implies NO 'a' yet).
c If I type 'k' then 'M'. 'k' -> 'क्' + 'M' -> 'कं' is usually expected?
c NO. 'k' means 'k' (halant-default logic).
c So 'k'+'M' -> 'क्' + 'ं' (invalid).
c Usually 'a'+'M' -> 'अं'. 'ka' + 'M' -> 'कं'.
c If I type 'k' (Latin) then 'M'. 'k' SHOULD become 'क' (Implicit A) + 'ं'?
c Or 'k' (Halant) + 'ं'?
c Standard ITRANS: 'kM' -> 'कं'. 'k' implies 'ka' context for modifiers?
c Let's assume 'k'+'M' -> 'कं'.
any(ConsonantKeys) + 'M' > index(Consonants, 1) 'ं'
any(ConsonantKeys) + 'H' > index(Consonants, 1) 'ः'

c 6. Double Vowels (aa/ii/uu)
c 6. Double Vowels (aa/ii/uu)
c aa -> A (After full consonant)
any(AllDevaConsonants) + 'a' > context 'ा'
'अ' + 'a' > 'आ'

c ai -> Ai (matra)
any(AllDevaConsonants) + 'i' > context 'ै'

c au -> Au (matra)
any(AllDevaConsonants) + 'u' > context 'ौ'

c ii -> I (matra)
c Replace Consonant+ShortMatra with Consonant+LongMatra
any(AllDevaConsonants) 'ि' + 'i' > index(AllDevaConsonants, 1) 'ी'

c uu -> U (matra)
c Replace Consonant+ShortMatra with Consonant+LongMatra
any(AllDevaConsonants) 'ु' + 'u' > index(AllDevaConsonants, 1) 'ू'
'ू' + 'u' > context

c ee -> I (matra, alt)
any(AllDevaConsonants) 'े' + 'e' > index(AllDevaConsonants, 1) 'ी'

c oo -> U (matra, alt)
any(AllDevaConsonants) 'ो' + 'o' > index(AllDevaConsonants, 1) 'ू'

c 7. Explicit Virama (Commit)
any(ConsonantKeys) + '\' > index(Consonants, 1) '्'
deadkey(asp) + '\' > '्'

c Special Special
c Numbers
+ any(NumberKeys) > index(Numbers, 1)
